# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Dùng cho CORS + link trong email reset password
FRONTEND_URL=http://localhost:5173

# ---- Database (MySQL/MariaDB) ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hrm_dev

# ---- JWT ----
# JWT_SECRET phải >= 64 ký tự random (app fail-fast nếu ngắn hơn).
# Sinh mới: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_random_string_at_least_64_chars_long_xxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Auth policy ----
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_CONCURRENT_SESSIONS=5
AUTH_RESET_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_COOKIE_NAME=refresh_token

# ---- Mail ----
# dev  = render email ra file HTML trong logs/mail (không gửi thật) – mặc định
# smtp = gửi thật qua SMTP; host/port/user/password cấu hình bởi admin qua
#        /settings/mail (lưu trong DB, KHÔNG phải env) sau khi app đã chạy.
MAIL_TRANSPORT=dev
MAIL_FROM=no-reply@company.local
MAIL_FROM_NAME=HRM System
MAIL_DEV_OUTPUT_DIR=logs/mail
AWS_REGION=ap-southeast-1

# ---- Settings encryption ----
# Khoá AES-256 (64 ký tự hex) để mã hoá mật khẩu SMTP lưu trong DB
# (system_mail_settings.smtp_password_encrypted). BẮT BUỘC, app fail-fast nếu thiếu.
# Sinh mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=change_me_to_a_random_64_char_hex_string_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Storage (avatar, file dinh kem) ----
# local = ghi file xuong thu muc STORAGE_LOCAL_DIR (mac dinh, khong can AWS)
# s3    = upload len S3 (can `npm install @aws-sdk/client-s3` + credentials)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# Mac dinh la /<API_PREFIX>/uploads (vd /api/v1/uploads) de dung chung Vite proxy.
# STORAGE_LOCAL_PUBLIC_PATH=/api/v1/uploads
# Bat buoc khi STORAGE_DRIVER=s3
S3_BUCKET=
# CDN/CloudFront base URL; de trong = dung endpoint S3 mac dinh
S3_PUBLIC_BASE_URL=
# Dung luong toi da cua avatar (byte) - 2MB theo api-spec.md 3
AVATAR_MAX_BYTES=2097152

# ---- Seed (DEV ONLY) ----
# Mật khẩu cho toàn bộ tài khoản do `npm run seed` tạo ra.
# CHỈ dùng ở máy dev; TUYỆT ĐỐI không dùng cho môi trường có dữ liệu thật.
SEED_DEFAULT_PASSWORD=đặt_mật_khẩu_dev_tối_thiểu_8_ký_tự
